USE_IN_MEMORY_DB=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/aws_try_out
# Local Moto S3 settings for running the app with uv on the host.
S3_BUCKET_NAME=aws-try-out-images
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:5000
# Fake credentials for the local Moto endpoint only.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
