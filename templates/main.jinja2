from __future__ import annotations

from collections.abc import Awaitable, Callable

from fastapi import APIRouter


{{imports | replace('from typing import List', '')}}


def register_notes_routes(
    router: APIRouter,
    *,
{% for operation in operations %}
    {{operation.function_name}}: Callable[..., Awaitable[{{operation.return_type | replace('List[', 'list[')}}]],
{% endfor %}
) -> None:
    """Register every specified operation; all handlers are required."""
{% for operation in operations %}
    router.add_api_route(
        '{{operation.path}}',
        {{operation.function_name}},
        methods=['{{operation.type | upper}}'],
        operation_id='{{operation.function_name}}',
        response_model={{operation.response | replace('List[', 'list[')}},
        status_code={{operation.status_code or 200}},
{% for status, response in operation.responses.items() %}
{% if status | string == (operation.status_code or 200) | string %}
        response_description={{response.description | tojson}},
{% endif %}
{% endfor %}
{% if operation.responses | length > 1 %}
        responses={
{% for status, response in operation.responses.items() %}
{% if status | string != (operation.status_code or 200) | string %}
            {{status | tojson}}: {
                'description': {{response.description | tojson}},
{% for response_status, models in operation.additional_responses.items() %}
{% if response_status | string == status | string %}
{% for key, model in models.items() %}
                '{{key}}': {{model}},
{% endfor %}
{% endif %}
{% endfor %}
            },
{% endif %}
{% endfor %}
        },
{% endif %}
{% if operation.tags %}
        tags={{operation.tags}},
{% endif %}
{% if operation.summary %}
        summary={{operation.summary | tojson}},
{% endif %}
    )
{% endfor %}
